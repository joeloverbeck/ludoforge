{
  "name": "ludoforge",
  "private": true,
  "type": "module",
  "bin": {
    "ludoforge-evolve": "./src/cli/ludoforge-evolve.js",
    "ludoforge-play": "./dist/tui/ludoforge-play.js"
  },
  "dependencies": {
    "ajv": "^8.12.0",
    "ink": "^5.2.1",
    "ink-select-input": "^6.2.0",
    "listr2": "^10.1.0",
    "pino": "^10.3.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "dependency-cruiser": "^17.3.7",
    "esbuild": "^0.24.2",
    "pino-pretty": "^13.1.3"
  },
  "scripts": {
    "test": "npm run test:unit",
    "test:unit": "node --experimental-test-module-mocks --test --test-reporter=spec test/unit/**/*.test.mjs && tsc -p tsconfig.json",
    "test:integration": "node --test --test-reporter=spec test/integration/**/*.test.mjs",
    "test:e2e": "node --experimental-test-module-mocks --test --test-reporter=spec test/e2e/**/*.test.mjs",
    "test:performance": "node --test --test-reporter=spec test/performance/**/*.test.mjs",
    "test:memory": "node --test --test-reporter=spec test/memory/**/*.test.mjs",
    "evolve:default": "node ./src/cli/ludoforge-evolve.js --config experiments/default.json --verbose",
    "build:tui": "node scripts/build-tui.js",
    "play": "npm run build:tui && node dist/tui/ludoforge-play.js"
  }
}
