{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ludoforge.dev/schemas/dsl/game-definition.v1.json",
  "title": "GameDefinition",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "players", "state", "actions", "turn", "termination"],
  "properties": {
    "version": { "type": "string" },
    "players": { "$ref": "#/$defs/PlayersDef" },
    "state": { "$ref": "#/$defs/StateDef" },
    "actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/ActionDef" }
    },
    "turn": { "$ref": "#/$defs/TurnDef" },
    "termination": { "$ref": "#/$defs/TerminationBlock" },
    "triggers": {
      "type": "array",
      "items": { "$ref": "#/$defs/TriggerDef" }
    }
  },
  "$defs": {
    "ScalarValue": {
      "type": ["number", "boolean", "string"]
    },
    "PlayersDef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count"],
      "properties": {
        "count": { "type": "integer", "minimum": 1 },
        "roles": {
          "type": "array",
          "items": { "type": "string" }
        },
        "teams": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "StateDef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variables"],
      "properties": {
        "variables": {
          "type": "array",
          "items": { "$ref": "#/$defs/VariableDef" }
        },
        "tokenTypes": {
          "type": "array",
          "items": { "$ref": "#/$defs/TokenTypeDef" }
        },
        "zones": {
          "type": "array",
          "items": { "$ref": "#/$defs/ZoneDef" }
        }
      }
    },
    "VariableDef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scope", "type", "initial"],
      "properties": {
        "id": { "type": "string" },
        "scope": { "type": "string", "enum": ["global", "per_player"] },
        "type": { "$ref": "#/$defs/VariableTypeDef" },
        "initial": { "$ref": "#/$defs/ScalarValue" }
      }
    },
    "VariableTypeDef": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "const": "int" },
            "min": { "type": "integer" },
            "max": { "type": "integer" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "const": "bool" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "const": "enum" },
            "values": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      ]
    },
    "TokenTypeDef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "attributes"],
      "properties": {
        "id": { "type": "string" },
        "attributes": {
          "type": "array",
          "items": { "$ref": "#/$defs/VariableDef" }
        }
      }
    },
    "ZoneDef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tokenType", "scope", "order", "visibility"],
      "properties": {
        "id": { "type": "string" },
        "tokenType": { "type": "string" },
        "scope": { "type": "string", "enum": ["global", "per_player"] },
        "order": { "type": "string", "enum": ["ordered", "unordered"] },
        "visibility": { "type": "string", "enum": ["public", "private"] },
        "spatial": {
          "type": "object",
          "additionalProperties": false,
          "required": ["nodes", "edges"],
          "properties": {
            "nodes": {
              "type": "array",
              "items": { "type": "string" }
            },
            "edges": {
              "type": "array",
              "items": {
                "type": "array",
                "items": { "type": "string" },
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        }
      }
    },
    "ActionDef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "actor", "effects"],
      "properties": {
        "id": { "type": "string" },
        "actor": { "type": "string", "enum": ["any", "player", "role", "environment"] },
        "actorRole": { "type": "string" },
        "preconditions": { "$ref": "#/$defs/Expr" },
        "costs": {
          "type": "array",
          "items": { "$ref": "#/$defs/Effect" }
        },
        "effects": {
          "type": "array",
          "items": { "$ref": "#/$defs/Effect" }
        },
        "targets": {
          "type": "array",
          "items": { "$ref": "#/$defs/TargetDef" }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "phase": { "type": "string" },
            "speed": { "type": "string", "enum": ["normal", "reaction"] }
          }
        }
      }
    },
    "TargetDef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "selector"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "type": "string", "enum": ["token", "player", "zone"] },
        "selector": { "$ref": "#/$defs/SelectorDef" }
      }
    },
    "SelectorDef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "where": { "$ref": "#/$defs/Expr" },
        "zone": { "type": "string" },
        "tokenType": { "type": "string" },
        "player": { "type": "string", "enum": ["self", "opponent", "any"] },
        "count": { "type": "integer" },
        "random": { "type": "boolean" }
      }
    },
    "Effect": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "target"],
          "properties": {
            "kind": { "const": "set" },
            "target": { "$ref": "#/$defs/Ref" },
            "value": { "$ref": "#/$defs/ScalarValue" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "target"],
          "properties": {
            "kind": { "const": "inc" },
            "target": { "$ref": "#/$defs/Ref" },
            "amount": { "type": "number" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "target"],
          "properties": {
            "kind": { "const": "dec" },
            "target": { "$ref": "#/$defs/Ref" },
            "amount": { "type": "number" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "target"],
          "properties": {
            "kind": { "const": "move" },
            "target": { "$ref": "#/$defs/Ref" },
            "toZone": { "type": "string" },
            "toPlayer": { "type": "string", "enum": ["self", "opponent", "next", "previous"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "target"],
          "properties": {
            "kind": { "const": "spawn" },
            "target": { "$ref": "#/$defs/Ref" },
            "toZone": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "target"],
          "properties": {
            "kind": { "const": "destroy" },
            "target": { "$ref": "#/$defs/Ref" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "target"],
          "properties": {
            "kind": { "const": "reveal" },
            "target": { "$ref": "#/$defs/Ref" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "target"],
          "properties": {
            "kind": { "const": "hide" },
            "target": { "$ref": "#/$defs/Ref" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "target", "zone"],
          "properties": {
            "kind": { "const": "move_spatial" },
            "target": { "$ref": "#/$defs/Ref" },
            "zone": { "type": "string" },
            "toNode": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "effects"],
          "properties": {
            "kind": { "const": "repeat" },
            "count": { "type": "integer", "minimum": 1, "maximum": 10 },
            "effects": {
              "type": "array",
              "items": { "$ref": "#/$defs/Effect" },
              "minItems": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "condition", "then"],
          "properties": {
            "kind": { "const": "conditional" },
            "condition": { "$ref": "#/$defs/Expr" },
            "then": {
              "type": "array",
              "items": { "$ref": "#/$defs/Effect" }
            },
            "else": {
              "type": "array",
              "items": { "$ref": "#/$defs/Effect" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "target", "flag"],
          "properties": {
            "kind": { "const": "set_flag" },
            "target": { "$ref": "#/$defs/Ref" },
            "flag": { "type": "string" },
            "duration": { "type": "string", "enum": ["action", "phase", "turn", "round"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "order", "variable", "direction"],
          "properties": {
            "kind": { "const": "set_turn_order" },
            "order": { "const": "by_variable" },
            "variable": { "type": "string" },
            "direction": { "type": "string", "enum": ["asc", "desc"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "options"],
          "properties": {
            "kind": { "const": "choose" },
            "options": {
              "type": "array",
              "items": {
                "type": "array",
                "items": { "$ref": "#/$defs/Effect" }
              }
            },
            "count": { "type": "integer", "minimum": 1, "default": 1 }
          }
        }
      ]
    },
    "TriggerDef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event", "effects"],
      "properties": {
        "event": {
          "type": "string",
          "enum": [
            "start_turn",
            "end_turn",
            "start_phase",
            "end_phase",
            "start_round",
            "end_round",
            "after_action",
            "state_change",
            "threshold"
          ]
        },
        "condition": { "$ref": "#/$defs/Expr" },
        "effects": {
          "type": "array",
          "items": { "$ref": "#/$defs/Effect" }
        }
      }
    },
    "TurnDef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheduler"],
      "properties": {
        "scheduler": {
          "type": "string",
          "enum": ["round_robin", "priority_queue", "token_holder", "simultaneous", "random_draw", "custom"]
        },
        "resolution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["order"],
          "properties": {
            "order": { "type": "string", "enum": ["by_player_id", "random"] }
          }
        },
        "tokenType": { "type": "string" },
        "zone": { "type": "string" },
        "orderBy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["variable", "direction"],
          "properties": {
            "variable": { "type": "string" },
            "direction": { "type": "string", "enum": ["asc", "desc"] }
          }
        },
        "phases": {
          "type": "array",
          "items": { "type": "string" }
        },
        "stepEffects": {
          "type": "array",
          "items": { "$ref": "#/$defs/TriggerDef" }
        },
        "noLegalActions": { "$ref": "#/$defs/NoLegalActionsDef" }
      },
      "allOf": [
        {
          "if": { "properties": { "scheduler": { "const": "token_holder" } } },
          "then": {
            "required": ["tokenType", "zone"],
            "properties": {
              "tokenType": {},
              "zone": {}
            }
          }
        },
        {
          "if": { "properties": { "scheduler": { "const": "priority_queue" } } },
          "then": {
            "required": ["orderBy"],
            "properties": {
              "orderBy": {}
            }
          }
        }
      ]
    },
    "NoLegalActionsDef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy"],
      "properties": {
        "policy": { "type": "string", "enum": ["terminate", "pass", "error"] },
        "defaultOutcome": { "$ref": "#/$defs/OutcomeDef" },
        "reason": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "policy": { "const": "terminate" } } },
          "then": {
            "required": ["defaultOutcome"],
            "properties": { "defaultOutcome": {} }
          },
          "else": {
            "not": {
              "required": ["defaultOutcome"],
              "properties": { "defaultOutcome": {} }
            }
          }
        }
      ]
    },
    "TerminationBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conditions"],
      "properties": {
        "conditions": {
          "type": "array",
          "items": { "$ref": "#/$defs/TerminationDef" }
        },
        "maxTurns": { "type": "integer" },
        "scoring": { "$ref": "#/$defs/ScoreDef" }
      }
    },
    "TerminationDef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condition", "outcome"],
      "properties": {
        "condition": { "$ref": "#/$defs/Expr" },
        "outcome": { "$ref": "#/$defs/OutcomeDef" }
      }
    },
    "OutcomeDef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["win", "lose", "draw"] },
        "players": {
          "oneOf": [
            { "type": "string", "enum": ["all", "active"] },
            {
              "type": "array",
              "items": { "type": "integer" }
            }
          ]
        }
      }
    },
    "ScoreDef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["perPlayer"],
      "properties": {
        "perPlayer": { "$ref": "#/$defs/Expr" }
      }
    },
    "Expr": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "const": "and" },
            "left": { "$ref": "#/$defs/Expr" },
            "right": { "$ref": "#/$defs/Expr" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "const": "or" },
            "left": { "$ref": "#/$defs/Expr" },
            "right": { "$ref": "#/$defs/Expr" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "const": "not" },
            "value": { "$ref": "#/$defs/Expr" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "const": "cmp" },
            "op": { "type": "string", "enum": ["==", "!=", "<", "<=", ">", ">="] },
            "left": { "$ref": "#/$defs/Expr" },
            "right": { "$ref": "#/$defs/Expr" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "const": "value" },
            "value": { "$ref": "#/$defs/ScalarValue" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "const": "ref" },
            "ref": { "$ref": "#/$defs/ExprRef" }
          }
        }
      ]
    },
    "MetaRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "const": "meta" },
        "id": { "type": "string", "enum": ["legalActionCount", "hasLegalActions"] }
      }
    },
    "ExprRef": {
      "oneOf": [{ "$ref": "#/$defs/Ref" }, { "$ref": "#/$defs/MetaRef" }]
    },
    "Ref": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": { "const": "var" },
            "id": { "type": "string" },
            "attribute": { "type": "string" },
            "player": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": { "const": "token" },
            "id": { "type": "string" },
            "attribute": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": { "const": "zone" },
            "id": { "type": "string" },
            "attribute": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": { "const": "player" },
            "id": { "type": "string" },
            "attribute": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id", "query"],
          "properties": {
            "kind": { "const": "zone_query" },
            "id": { "type": "string" },
            "query": { "type": "string", "enum": ["count", "has_token"] },
            "tokenType": { "type": "string" },
            "player": { "type": "string", "enum": ["self", "opponent", "any"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id", "flag"],
          "properties": {
            "kind": { "const": "flag_query" },
            "id": { "type": "string" },
            "flag": { "type": "string" }
          }
        }
      ]
    }
  }
}
