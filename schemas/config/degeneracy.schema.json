{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ludoforge.dev/schemas/config/degeneracy.schema.json",
  "title": "DegeneracyConfigFile",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "thresholds", "enabledFlags", "policyByFlag", "penalties"],
  "properties": {
    "version": { "type": "integer", "minimum": 2 },
    "updatedAt": { "type": "string" },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["loop", "forcedMove", "dominantAction", "trivialWin"],
      "properties": {
        "loop": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repeatedStateRatio", "minRepeatedStates"],
          "properties": {
            "repeatedStateRatio": { "type": "number", "minimum": 0, "maximum": 1 },
            "minRepeatedStates": { "type": "integer", "minimum": 1 }
          }
        },
        "forcedMove": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ratio"],
          "properties": {
            "ratio": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "dominantAction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ratio", "minSamples"],
          "properties": {
            "ratio": { "type": "number", "minimum": 0, "maximum": 1 },
            "minSamples": { "type": "integer", "minimum": 1 }
          }
        },
        "trivialWin": {
          "type": "object",
          "additionalProperties": false,
          "required": ["winRate", "maxAvgSteps", "minSamples"],
          "properties": {
            "winRate": { "type": "number", "minimum": 0, "maximum": 1 },
            "maxAvgSteps": { "type": "integer", "minimum": 1 },
            "minSamples": { "type": "integer", "minimum": 1 }
          }
        },
        "highSkippedEffects": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rate", "minAttempts"],
          "properties": {
            "rate": { "type": "number", "minimum": 0, "maximum": 1 },
            "minAttempts": { "type": "integer", "minimum": 1 }
          }
        },
        "anyCostAbort": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minCount"],
          "properties": {
            "minCount": { "type": "integer", "minimum": 1 }
          }
        },
        "highSkippedTriggers": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rate", "minAttempts"],
          "properties": {
            "rate": { "type": "number", "minimum": 0, "maximum": 1 },
            "minAttempts": { "type": "integer", "minimum": 1 }
          }
        },
        "highPassRate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rate", "minSteps"],
          "properties": {
            "rate": { "type": "number", "minimum": 0, "maximum": 1 },
            "minSteps": { "type": "integer", "minimum": 1 }
          }
        },
        "highNoLegalActionsTermination": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rate", "minRuns"],
          "properties": {
            "rate": { "type": "number", "minimum": 0, "maximum": 1 },
            "minRuns": { "type": "integer", "minimum": 1 }
          }
        },
        "nonFiniteMetrics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minKeys"],
          "properties": {
            "minKeys": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "enabledFlags": {
      "type": "array",
      "items": { "$ref": "#/$defs/DegeneracyFlag" }
    },
    "policyByFlag": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "loop": { "$ref": "#/$defs/DegeneracyPolicy" },
        "stalemate": { "$ref": "#/$defs/DegeneracyPolicy" },
        "forced-move": { "$ref": "#/$defs/DegeneracyPolicy" },
        "dominant-action": { "$ref": "#/$defs/DegeneracyPolicy" },
        "trivial-win": { "$ref": "#/$defs/DegeneracyPolicy" },
        "no-choices": { "$ref": "#/$defs/DegeneracyPolicy" },
        "non-terminating": { "$ref": "#/$defs/DegeneracyPolicy" },
        "high-skipped-effects": { "$ref": "#/$defs/DegeneracyPolicy" },
        "any-cost-abort": { "$ref": "#/$defs/DegeneracyPolicy" },
        "high-skipped-triggers": { "$ref": "#/$defs/DegeneracyPolicy" },
        "high-pass-rate": { "$ref": "#/$defs/DegeneracyPolicy" },
        "high-no-legal-actions-termination": { "$ref": "#/$defs/DegeneracyPolicy" },
        "non-finite-metrics": { "$ref": "#/$defs/DegeneracyPolicy" }
      }
    },
    "penalties": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "forced-move": {
          "type": "object",
          "additionalProperties": false,
          "required": ["weight", "freeRatio"],
          "properties": {
            "weight": { "type": "number", "minimum": 0 },
            "freeRatio": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "no-choices": {
          "type": "object",
          "additionalProperties": false,
          "required": ["weight"],
          "properties": {
            "weight": { "type": "number", "minimum": 0 }
          }
        },
        "dominant-action": {
          "type": "object",
          "additionalProperties": false,
          "required": ["weight"],
          "properties": {
            "weight": { "type": "number", "minimum": 0 }
          }
        },
        "trivial-win": {
          "type": "object",
          "additionalProperties": false,
          "required": ["weight"],
          "properties": {
            "weight": { "type": "number", "minimum": 0 }
          }
        },
        "stalemate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["weight"],
          "properties": {
            "weight": { "type": "number", "minimum": 0 }
          }
        },
        "high-skipped-effects": {
          "type": "object",
          "additionalProperties": false,
          "required": ["weight"],
          "properties": {
            "weight": { "type": "number", "minimum": 0 }
          }
        },
        "high-skipped-triggers": {
          "type": "object",
          "additionalProperties": false,
          "required": ["weight"],
          "properties": {
            "weight": { "type": "number", "minimum": 0 }
          }
        },
        "high-pass-rate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["weight"],
          "properties": {
            "weight": { "type": "number", "minimum": 0 }
          }
        },
        "high-no-legal-actions-termination": {
          "type": "object",
          "additionalProperties": false,
          "required": ["weight"],
          "properties": {
            "weight": { "type": "number", "minimum": 0 }
          }
        },
        "non-finite-metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["weight"],
          "properties": {
            "weight": { "type": "number", "minimum": 0 }
          }
        }
      }
    },
    "minStepsForNoChoices": {
      "type": "integer",
      "minimum": 1,
      "default": 10
    },
    "compoundRejection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "maxPenaltyFlags"],
      "properties": {
        "enabled": { "type": "boolean" },
        "maxPenaltyFlags": { "type": "integer", "minimum": 1 }
      }
    }
  },
  "$defs": {
    "DegeneracyFlag": {
      "type": "string",
      "enum": [
        "loop",
        "stalemate",
        "forced-move",
        "dominant-action",
        "trivial-win",
        "no-choices",
        "non-terminating",
        "high-skipped-effects",
        "any-cost-abort",
        "high-skipped-triggers",
        "high-pass-rate",
        "high-no-legal-actions-termination",
        "non-finite-metrics"
      ]
    },
    "DegeneracyPolicy": {
      "$ref": "https://ludoforge.dev/schemas/shared/degeneracy-policy.schema.json"
    }
  }
}
