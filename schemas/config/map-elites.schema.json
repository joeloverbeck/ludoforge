{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ludoforge.dev/schemas/config/map-elites.schema.json",
  "title": "MapElitesConfigFile",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "descriptors", "fitnessKey", "tieBreak"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "updatedAt": { "type": "string" },
    "descriptors": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/DescriptorConfig" }
    },
    "fitnessKey": {
      "anyOf": [
        { "type": "string", "minLength": 1 },
        { "type": "null" }
      ]
    },
    "tieBreak": { "type": "string", "enum": ["keep", "replace"] }
  },
  "$defs": {
    "DescriptorConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "min", "max", "bins"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "bins": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
