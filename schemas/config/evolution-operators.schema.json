{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ludoforge.dev/schemas/config/evolution-operators.schema.json",
  "title": "EvolutionOperatorsConfigFile",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "mutation", "crossover", "repair"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "updatedAt": { "type": "string" },
    "mutation": { "$ref": "#/$defs/MutationGroup" },
    "crossover": { "$ref": "#/$defs/CrossoverGroup" },
    "repair": { "$ref": "#/$defs/RepairGroup" }
  },
  "$defs": {
    "MutationOperatorKind": {
      "type": "string",
      "enum": [
        "numeric-tweak",
        "boolean-toggle",
        "enum-cycle",
        "action-duplicate",
        "action-remove",
        "action-effect-magnitude",
        "precondition-negation",
        "termination-threshold",
        "termination-outcome",
        "phase-add",
        "phase-remove",
        "token-zone-target-add",
        "token-type-remove",
        "zone-remove",
        "effect-insert",
        "effect-delete",
        "effect-param-tweak",
        "effect-kind-swap",
        "effect-reorder",
        "action-add-small",
        "action-cost-tweak",
        "motif-inject",
        "zone-add",
        "token-type-add",
        "trigger-add",
        "scheduler-swap",
        "scheduler-param-tweak",
        "conditional-effect-insert",
        "turn-order-effect-insert",
        "choose-effect-insert",
        "worker-count-tweak"
      ]
    },
    "CrossoverOperatorKind": {
      "type": "string",
      "enum": [
        "subtree-swap"
      ]
    },
    "RepairOperatorKind": {
      "type": "string",
      "enum": [
        "dsl-safety"
      ]
    },
    "MutationGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "weights"],
      "properties": {
        "enabled": {
          "type": "array",
          "items": { "$ref": "#/$defs/MutationOperatorKind" }
        },
        "weights": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/MutationOperatorKind" },
          "additionalProperties": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    },
    "CrossoverGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": {
          "type": "array",
          "items": { "$ref": "#/$defs/CrossoverOperatorKind" }
        },
        "weights": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/CrossoverOperatorKind" },
          "additionalProperties": { "type": "number" }
        }
      }
    },
    "RepairGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": {
          "type": "array",
          "items": { "$ref": "#/$defs/RepairOperatorKind" }
        },
        "weights": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/RepairOperatorKind" },
          "additionalProperties": { "type": "number" }
        }
      }
    }
  }
}
