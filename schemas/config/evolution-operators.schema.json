{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ludoforge.dev/schemas/config/evolution-operators.schema.json",
  "title": "EvolutionOperatorsConfigFile",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "mutation", "crossover", "repair"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "updatedAt": { "type": "string" },
    "mutation": { "$ref": "#/$defs/OperatorGroup" },
    "crossover": { "$ref": "#/$defs/OperatorGroup" },
    "repair": { "$ref": "#/$defs/OperatorGroup" }
  },
  "$defs": {
    "OperatorGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "weights": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        }
      }
    }
  }
}
