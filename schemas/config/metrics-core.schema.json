{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ludoforge.dev/schemas/config/metrics-core.schema.json",
  "title": "MetricsCoreConfigFile",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "enabled", "normalization", "featureOrder"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "updatedAt": { "type": "string" },
    "enabled": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nonFinite"],
      "properties": {
        "nonFinite": { "type": "string", "enum": ["zero"] },
        "nonFinitePolicy": {
          "type": "string",
          "enum": ["penalize", "reject"],
          "default": "penalize"
        },
        "nonFinitePenalty": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "perKeyPenalty": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 0.05
            },
            "maxPenalty": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 0.50
            }
          }
        }
      }
    },
    "featureOrder": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
