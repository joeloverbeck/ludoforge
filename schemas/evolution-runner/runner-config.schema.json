{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ludoforge.dev/schemas/evolution-runner/runner-config.schema.json",
  "title": "EvolutionRunnerConfig",
  "type": "object",
  "additionalProperties": false,
  "required": ["runner", "mapElites", "seeding", "humanFeedback", "evolution"],
  "properties": {
    "seed": { "type": "integer" },
    "runner": { "$ref": "#/$defs/RunnerLoopConfig" },
    "evaluation": { "$ref": "#/$defs/EvaluationConfig" },
    "evolution": { "$ref": "#/$defs/EvolutionConfig" },
    "mapElites": { "$ref": "#/$defs/MapElitesConfig" },
    "humanFeedback": { "$ref": "#/$defs/HumanFeedbackConfig" },
    "seeding": { "$ref": "#/$defs/SeedingConfig" }
  },
  "$defs": {
    "RunnerLoopConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generations", "maxRetainedGenerations"],
      "properties": {
        "generations": { "type": "integer", "minimum": 1 },
        "shortlistSize": { "type": "integer", "minimum": 0 },
        "saveEvery": { "type": "integer", "minimum": 1 },
        "maxRetainedGenerations": { "type": "integer", "minimum": 1 },
        "rejectionRateThreshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "maxConsecutiveRejections": { "type": "integer", "minimum": 1 },
        "minPopulationSize": { "type": "integer", "minimum": 1 },
        "maxPopulationSize": { "type": "integer", "minimum": 1 }
      }
    },
    "EvaluationConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "simulation": { "type": "object", "additionalProperties": true },
        "metrics": { "type": "object", "additionalProperties": true },
        "fitness": { "type": "object", "additionalProperties": true },
        "degeneracy": { "$ref": "#/$defs/DegeneracyBlock" }
      }
    },
    "DegeneracyPolicy": {
      "$ref": "https://ludoforge.dev/schemas/shared/degeneracy-policy.schema.json"
    },
    "DegeneracyBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policyByFlag", "penalties"],
      "properties": {
        "policyByFlag": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/DegeneracyPolicy" }
        },
        "penalties": {
          "type": "object",
          "additionalProperties": { "type": "object", "additionalProperties": true }
        }
      }
    },
    "EvolutionConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["motifMining"],
      "properties": {
        "mutation": { "type": "object", "additionalProperties": true },
        "crossover": { "type": "object", "additionalProperties": true },
        "repair": { "type": "object", "additionalProperties": true },
        "motifMining": { "$ref": "#/$defs/MotifMiningConfig" }
      }
    },
    "EliteSelectionConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["perNicheTopK", "globalTopK"],
      "properties": {
        "perNicheTopK": { "type": "integer", "minimum": 1 },
        "globalTopK": { "type": "integer", "minimum": 1 }
      }
    },
    "MotifMiningConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "eliteSelection", "minSupport", "maxMotifLength", "ngramSizes"],
      "properties": {
        "enabled": { "type": "boolean" },
        "eliteSelection": { "$ref": "#/$defs/EliteSelectionConfig" },
        "minSupport": { "type": "integer", "minimum": 1 },
        "maxMotifLength": { "type": "integer", "minimum": 2 },
        "ngramSizes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 1 }
        },
        "seed": { "type": "integer" }
      }
    },
    "MapElitesDescriptorConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "min", "max", "bins"],
      "properties": {
        "id": {
          "allOf": [
            {
              "$ref": "https://ludoforge.dev/schemas/shared/metric-id.schema.json"
            }
          ]
        },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "bins": { "type": "integer", "minimum": 1 }
      }
    },
    "MapElitesConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["descriptors"],
      "properties": {
        "descriptors": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/MapElitesDescriptorConfig" }
        },
        "fitnessKey": { "type": "string", "minLength": 1 },
        "tieBreak": { "type": "string", "enum": ["keep", "replace"] }
      }
    },
    "HumanFeedbackConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "mode"],
      "properties": {
        "enabled": { "type": "boolean" },
        "mode": { "type": "string", "enum": ["rating", "comparison"] },
        "maxSamplesPerGen": { "type": "integer", "minimum": 1 },
        "activeLearning": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "uncertaintyThreshold": { "type": "number", "minimum": 0 },
            "diversityQuota": { "type": "number", "minimum": 0 }
          }
        },
        "adaptiveBudget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "lowUncertaintyThreshold": { "type": "number", "minimum": 0, "maximum": 1 },
            "highUncertaintyThreshold": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    },
    "SeedingConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "populationSize"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["generate", "folder", "mixed"]
        },
        "populationSize": {
          "type": "integer",
          "minimum": 1
        },
        "folder": { "$ref": "#/$defs/SeedingFolderConfig" },
        "generate": { "$ref": "#/$defs/SeedingGenerateConfig" },
        "mix": { "$ref": "#/$defs/SeedingMixConfig" }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": { "mode": { "const": "folder" } },
            "required": ["mode"]
          },
          "then": {
            "type": "object",
            "properties": {
              "folder": { "$ref": "#/$defs/SeedingFolderConfig" }
            },
            "required": ["folder"]
          }
        },
        {
          "if": {
            "type": "object",
            "properties": { "mode": { "const": "generate" } },
            "required": ["mode"]
          },
          "then": {
            "type": "object",
            "properties": {
              "generate": { "$ref": "#/$defs/SeedingGenerateConfig" }
            },
            "required": ["generate"]
          }
        },
        {
          "if": {
            "type": "object",
            "properties": { "mode": { "const": "mixed" } },
            "required": ["mode"]
          },
          "then": {
            "type": "object",
            "properties": {
              "folder": { "$ref": "#/$defs/SeedingFolderConfig" },
              "generate": { "$ref": "#/$defs/SeedingGenerateConfig" },
              "mix": { "$ref": "#/$defs/SeedingMixConfig" }
            },
            "required": ["folder", "generate", "mix"]
          }
        }
      ]
    },
    "SeedingFolderConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string" },
        "onInvalid": {
          "type": "string",
          "enum": ["error", "skip"]
        }
      }
    },
    "SeedingGenerateConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coverage", "grammar"],
      "properties": {
        "coverage": { "$ref": "#/$defs/SeedingCoverageConfig" },
        "grammar": { "$ref": "#/$defs/SeedingGrammarConfig" }
      }
    },
    "SeedingCoverageConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "maxAttempts"],
      "properties": {
        "strategy": {
          "type": "string",
          "enum": ["uniform-bins", "underfilled-first", "random"]
        },
        "maxAttempts": {
          "type": "integer",
          "minimum": 1
        },
        "fallback": { "$ref": "#/$defs/SeedingCoverageFallbackConfig" },
        "specialOnly": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "policy": {
              "type": "string",
              "enum": ["allow", "cap", "reject"],
              "default": "reject"
            },
            "maxFraction": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 0.10
            },
            "maxCount": {
              "type": "integer",
              "minimum": 0,
              "default": 2147483647
            },
            "countTowardCoverage": {
              "type": "boolean",
              "default": false
            }
          }
        }
      }
    },
    "SeedingCoverageFallbackConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy"],
      "properties": {
        "strategy": {
          "type": "string",
          "enum": ["accept-any-valid"]
        }
      }
    },
    "SeedingGrammarConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "limits": { "$ref": "#/$defs/SeedingGrammarLimitsConfig" },
        "weights": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        }
      }
    },
    "SeedingGrammarLimitsConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minVariables": { "type": "integer", "minimum": 1 },
        "maxVariables": { "type": "integer", "minimum": 1 },
        "minActions": { "type": "integer", "minimum": 1 },
        "maxActions": { "type": "integer", "minimum": 1 }
      }
    },
    "SeedingMixConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["folderFraction"],
      "properties": {
        "folderFraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
